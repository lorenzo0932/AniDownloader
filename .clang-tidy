# clang-tidy — check ad alto valore e basso rumore.
# Fase 2: fail-on-error (feature 13) — il job CI fallisce su warning nuovi.
Checks: '-*,
         bugprone-*,
         performance-*,
         clang-analyzer-*,
         modernize-use-nullptr,
         modernize-use-override,
         modernize-use-default-member-init,
         modernize-redundant-void-arg,
         modernize-deprecated-headers,
         modernize-shrink-to-fit,
         modernize-loop-convert,
         modernize-avoid-c-arrays,
         readability-named-parameter,
         readability-delete-null-pointer,
         readability-simplify-boolean-expr,
         readability-misleading-indentation,
         readability-redundant-control-flow,
         readability-redundant-member-init,
         readability-static-accessed-through-instance'
WarningsAsErrors: ''
# Solo gli header del progetto (include/), mai le dipendenze vendored
# (build/_deps/...) né gli header auto-generati (embedded_web.hpp: dati binari
# in C-array da embed_web.py, non convertibili): inquinerebbero il report.
HeaderFilterRegex: '^(?!.*build/_deps)(?!.*embedded_web).*\.hpp$'
FormatStyle: file
CheckOptions:
  # Catch vuoti INTENZIONALI (già commentati con "intenzionale:"): il check
  # li considera deliberati, non nascondono bug. Esclusione config, mai inline.
  - key: bugprone-empty-catch.IgnoreCatchWithKeywords
    value: '@TODO;@FIXME;intenzionale'
  # httpGetWithRetry(url, headers, maxRetries, retryDelayMs): i due int sono
  # già nominati in modo non ambiguo; il rischio di scambio è solo teorico.
  - key: bugprone-easily-swappable-parameters.IgnoredParameterNames
    value: 'maxRetries;retryDelayMs'
