<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- AniDownloader demone (web + scheduler interno, ADR-004). Solo autostart:
     niente timer/CalendarInterval, i controlli periodici sono interni.
     Modello di riferimento: l'installazione reale passa da install-mac.sh,
     che genera il plist con i percorsi assoluti dell'utente e i log in
     ~/Library/Logs/AniDownloader (launchd non espande ~).
     Rimozione: uninstall-mac.sh (launchctl bootout + pulizia). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.anidownloader.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/anidownloaderd</string>
        <string>--web</string>
        <string>--silent</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/com.anidownloader.daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/com.anidownloader.daemon.err.log</string>
</dict>
</plist>
