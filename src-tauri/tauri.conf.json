{
  "productName": "AniDownloader",
  "version": "2.1.1",
  "identifier": "com.anidownloader.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/anidownloaderd"],
    "targets": ["nsis", "dmg"]
  }
}
