{
  "identifier": "default",
  "description": "Default permissions for AniDownloader",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/AniDownloader",
          "sidecar": true
        }
      ]
    },
    "dialog:default",
    "notification:default",
    "fs:default"
  ]
}
